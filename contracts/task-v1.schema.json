{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "requirements": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "data": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "fields": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,39}$"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "type": {
                      "type": "string",
                      "const": "text"
                    }
                  },
                  "required": [
                    "name",
                    "required",
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,39}$"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "type": {
                      "type": "string",
                      "const": "number"
                    }
                  },
                  "required": [
                    "name",
                    "required",
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,39}$"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "type": {
                      "type": "string",
                      "const": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "required",
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,39}$"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "type": {
                      "type": "string",
                      "const": "date"
                    }
                  },
                  "required": [
                    "name",
                    "required",
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,39}$"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "type": {
                      "type": "string",
                      "const": "enum"
                    },
                    "options": {
                      "minItems": 1,
                      "maxItems": 12,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      }
                    }
                  },
                  "required": [
                    "name",
                    "required",
                    "type",
                    "options"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "name",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    "preserve": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "acceptance": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "kind": {
            "type": "string",
            "enum": [
              "behavior",
              "regression"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "action",
          "expected",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "goal",
    "requirements",
    "data",
    "preserve",
    "acceptance"
  ],
  "additionalProperties": false,
  "x-contract-version": "1",
  "x-runtime-validation": {
    "maxUtf8Bytes": 32768,
    "unique": [
      "collection names",
      "field names within each collection",
      "acceptance IDs"
    ]
  }
}

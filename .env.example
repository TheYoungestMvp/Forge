# Copy this file to .env.local. Never expose this key through NEXT_PUBLIC_*.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# DeepSeek Chat Completions uses JSON mode and max_tokens.
# For a strict-schema compatible service, use json_schema and max_completion_tokens.
# Strict server-side validation applies in both modes.
LLM_OUTPUT_MODE=json_object
LLM_MAX_TOKENS_FIELD=max_tokens
# Optional DeepSeek setting: reserve the output budget for application code.
# Omit this variable for services that do not support the thinking parameter.
LLM_THINKING_MODE=disabled
GENERATION_TIMEOUT_MS=120000

# Optional local HTTP proxy. npm run dev/start load these before Node starts.
# Use your actual proxy address; leave unset when direct connections work.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1

# Supabase project URL and SERVER-ONLY secret key. Never use NEXT_PUBLIC_* for keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy server key can be used instead of SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=

# local for loopback demos; public deployments fail closed unless both secrets are configured.
FORGE_DEPLOYMENT=local
FORGE_SESSION_SECRET=
DEMO_ACCESS_PASSWORD=

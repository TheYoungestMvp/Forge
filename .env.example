# Copy this file to .env.local. Never expose this key through NEXT_PUBLIC_*.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# DeepSeek Chat Completions uses JSON mode and max_tokens.
# For a strict-schema compatible service, use json_schema and max_completion_tokens.
# Strict server-side validation applies in both modes.
LLM_OUTPUT_MODE=json_object
LLM_MAX_TOKENS_FIELD=max_tokens
# Optional DeepSeek setting: reserve the output budget for application code.
# Omit this variable for services that do not support the thinking parameter.
LLM_THINKING_MODE=disabled
GENERATION_TIMEOUT_MS=120000
